# DevOps Autopilot - Environment Configuration

# Flask Server
FLASK_ENV=development
PORT=5000
SECRET_KEY=devops-autopilot-secret-key-2026
DATABASE_URL=sqlite:///devops_autopilot.db

# LLM Configuration (OpenAI or compatible provider)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
LLM_PROVIDER=openai

# Cloud & Infra Cost Calibration (INR)
PRICE_PER_CORE_MONTH_INR=800.0
PRICE_PER_GB_MEM_MONTH_INR=250.0
DEFAULT_POD_COST_MONTH_INR=1200.0

# Safety Guardrails
DRY_RUN_DEFAULT=true
ALLOWED_NAMESPACES=staging,dev,demo
MAX_ACTIONS_PER_RUN=10
MAX_REPLICA_REDUCTION_PCT=0.50
PREVENT_PROD_EXECUTION=true

# Integrations
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T000/B000/XXXXX
USE_MOCK_METRICS=true
MOCK_METRICS_PATH=demo/metrics_sample.json
KUBECONFIG_PATH=~/.kube/config
AWS_REGION=ap-south-1
